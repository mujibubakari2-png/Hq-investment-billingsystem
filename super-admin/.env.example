# ─── Super Admin Platform Environment Variables ────────────────────────────────
# Copy this file to .env and fill in real values before running.
# This is a Vite SPA that connects to the backend API for platform administration.

# ── Development Environment ────────────────────────────────────────────────────
# Leave VITE_API_URL blank for dev — Vite dev server proxies /api to localhost:3000
VITE_API_URL=

# ── Production Environment ─────────────────────────────────────────────────────
# Uncomment and set to your backend API domain
# VITE_API_URL=https://api.yourdomain.com

# ── Build Configuration ────────────────────────────────────────────────────────
# Vite will expose these as import.meta.env.* in the application
VITE_APP_NAME=HQ Investment Platform Admin
VITE_APP_TITLE=Platform Super Admin
