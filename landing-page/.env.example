# ─── Landing Page Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in real values before running.

# Node Environment
NODE_ENV=development
PORT=3001

# Billing System URL (for login links)
NEXT_PUBLIC_BILLING_SYSTEM_URL=/billing

# Backend API URL (for internal calls)
BACKEND_API_URL=http://localhost:3000

# Database (same DB as backend — used for public product/category reads)
DATABASE_URL=postgresql://user:password@localhost:5432/hqinvestment

# WhatsApp number for "Contact Seller" button (with country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=255700000001

# Phone for Call button
NEXT_PUBLIC_PHONE_NUMBER=+255700000001

