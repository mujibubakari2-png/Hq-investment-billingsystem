model ProductCategory {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  icon        String? // emoji or icon name
  image       String? // URL to category image
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
  @@index([isActive])
  @@map("product_categories")
}

model Product {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  sku            String?          @unique
  barcode        String?
  categoryId     String?
  brandId        String?
  collectionId   String?
  warehouseId    String?
  taxClassId     String?
  price          Decimal          @db.Decimal(12, 2)
  discountType   String?          @default("percent") // "percent" | "fixed"
  discountValue  Decimal?         @db.Decimal(12, 2)
  currency       String           @default("TZS")
  quantity       Int              @default(0)
  description    String?
  specifications Json? // [{key: "Weight", value: "2kg"}, ...]
  tags           String[]
  status         ProductStatus    @default(DRAFT)
  featured       Boolean          @default(false)
  trending       Boolean          @default(false)
  bestSeller     Boolean          @default(false)
  isNew          Boolean          @default(false)
  viewCount      Int              @default(0)
  clickCount     Int              @default(0)
  seoTitle       String?
  seoDescription String?
  metaKeywords   String[]
  ogImage        String?
  scheduledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  collection     Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  warehouse      Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  taxClass       TaxClass?        @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  orderItems     EcomOrderItem[]
  reviews        Review[]
  stockMovements StockMovement[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([collectionId])
  @@index([status])
  @@index([featured])
  @@index([trending])
  @@index([bestSeller])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  isFeatured Boolean  @default(false)
  productId  String
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model EcomOrder {
  id              String          @id @default(uuid())
  orderNumber     String          @unique
  customerName    String
  customerEmail   String?
  customerPhone   String?
  shippingAddress Json? // {street, city, region, country, zip}
  totalAmount     Decimal         @db.Decimal(12, 2)
  status          OrderStatus     @default(PENDING)
  paymentMethod   String?
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentRef      String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  customerId      String?
  customer        EcomCustomer?   @relation(fields: [customerId], references: [id])
  items           EcomOrderItem[]

  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@index([customerId])
  @@index([createdAt])
  @@map("ecom_orders")
}

model EcomOrderItem {
  id        String    @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal   @db.Decimal(12, 2)
  total     Decimal   @db.Decimal(12, 2)
  order     EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("ecom_order_items")
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  authorName String
  email      String?
  rating     Int // 1-5
  title      String?
  comment    String?
  isApproved Boolean  @default(false)
